# Test enrollment/status endpoint

# Test with successful completion
curl -X POST http://localhost:9002/api/enrollment/status \
  -H "Content-Type: application/json" \
  -d '{
    "client_id": "6b8446f0-2919-4239-8ded-9ca3276f7759",
    "status": "completed"
  }'

# Test with abandoned flow
curl -X POST http://localhost:9002/api/enrollment/status \
  -H "Content-Type: application/json" \
  -d '{
    "client_id": "6b8446f0-2919-4239-8ded-9ca3276f7759",
    "status": "abandoned"
  }'

# Test with non-existent client (should fail gracefully)
curl -X POST http://localhost:9002/api/enrollment/status \
  -H "Content-Type: application/json" \
  -d '{
    "client_id": "568",
    "status": "abandoned"
  }'

# Test querying for a user with surname
curl -X POST http://localhost:9002/api/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "query",
    "table": "speakers",
    "firstname": "nathanael",
    "surname": "warren"
  }'

# Test querying for a user without surname (surname is NULL in database)
curl -X POST http://localhost:9002/api/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "query_database",
    "table": "speakers",
    "firstname": "courtney",
    "surname": null
  }'

# Expected responses:
# If found: {"uid": 1, "success": true}
# If not found: {"uid": null, "success": true}
# If error: {"error": "error message", "success": false}


# Test starting recording for existing user
curl -X POST http://localhost:9002/api/record \
  -H "Content-Type: application/json" \
  -d '{
    "client_id": "test-client-123",
    "uid": 1
  }'

# Test starting recording for new user (no uid)
curl -X POST http://localhost:9002/api/record \
  -H "Content-Type: application/json" \
  -d '{
    "client_id": "test-client-123",
    "uid": null
  }'

# Expected responses:
# If successful: {"success": true, "message": "Recording started for client test-client-123 (uid: 1)"}
# If client not connected: {"error": "Client not connected", "success": false}
# If error: {"error": "error message", "success": false}


# Trigger record pangram
curl -X POST http://localhost:9002/api/enrollment/record \
  -H "Content-Type: application/json" \
  -d '{
    "sender_id": "fd44157e-409e-48f4-bbe3-3d4790683a37",
    "imprint_uid": "1",
    "imprint_firstname": "Nathanael",
    "imprint_surname": "Warren"
  }'

# Get unique sources
curl -X POST http://localhost:9002/api/passages/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "unique_sources"
  }'

# High confidence source match (exact)
curl -X POST http://localhost:9002/api/passages/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "match_source",
    "fuzzy_source": "The Lightning Thief"
  }'

# Medium confidence source match (fuzzy)
curl -X POST http://localhost:9002/api/passages/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "match_source",
    "fuzzy_source": "lightning thief"
  }'

# Substring match (boosted confidence)
curl -X POST http://localhost:9002/api/passages/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "match_source",
    "fuzzy_source": "fifty shades"
  }'

# No match
curl -X POST http://localhost:9002/api/passages/query \
  -H "Content-Type: application/json" \
  -d '{
    "action": "match_source",
    "fuzzy_source": "harry potter"
  }'

# Fetch a random quote

# Do voice cloning
curl -X POST http://localhost:9002/api/voice-clone \
  -H "Content-Type: application/json" \
  -d '{
    "sender_id": "client_744f6bff-2855-4597-80c4-6ddc159be4c3",
    "speaker": "Nathanael Warren",
    "quote": "Hello, this is a test of the voice cloning system."
  }'

  curl -X POST http://localhost:9002/api/voice-clone \
  -H "Content-Type: application/json" \
  -d '{
    "sender_id": "aae405c7-234b-49dd-8d44-bb63337a06e0",
    "speaker": "Courtney Mosier Warren",
    "quote": "Please call Stella. Ask her to bring these things with her from the store: Six spoons of fresh snow peas, five thick slabs of blue cheese, and maybe a snack for her brother Bob."
  }'